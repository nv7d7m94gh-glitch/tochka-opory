    clients:[35,58,80,109,141],
    look:{skin:"#DDB08F", hair:"#2E2722", style:"short", shirt:"#6F7782", bg:"#E8ECEF"} },
  { id:"sokolova", name:"Екатерина Соколова", role:"Детский и подростковый психолог",
    short:"Дети и подростки",
    about:[
      "Помогает детям от 4 до 17 лет: адаптация к детскому саду и школе, страхи, трудности в учёбе и общении со сверстниками.",
