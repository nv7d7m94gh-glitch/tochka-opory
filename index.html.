function specialist(p){
  const i=SPECIALISTS.indexOf(p), next=SPECIALISTS[(i+1)%SPECIALISTS.length];
  const growth=Math.round((p.clients[4]/p.clients[0]-1)*100);
  return `<div class="view">
    <p class="crumbs"><a href="#">Главная</a> / Специалисты / ${p.name}</p>
    <section class="profile">
      <div class="ph">${portrait(p)}</div>
      <div class="about">
        <div><h1>${p.name}</h1><p class="role">${p.role}</p></div>
        ${p.about.map(t=>`<p>${t}</p>`).join("")}
        <ul class="tags">${p.topics.map(t=>`<li>${t}</li>`).join("")}</ul>
        <div class="facts">
          <div class="fact"><b>${p.years} лет</b><span>опыт работы</span></div>
          <div class="fact"><b>${p.clients[4]}</b><span>клиентов в 2025 году</span></div>
          <div class="fact"><b>${p.format}</b><span>${p.method}</span></div>
        </div>
      </div>
    </section>
    <section class="chart-block">
      <p class="eyebrow">Динамика роста клиентов</p>
      <h2>Число клиентов по годам, 2021–2025</h2>
      <p>За пять лет число клиентов выросло с ${p.clients[0]} до ${p.clients[4]} человек (+${growth}%).</p>
      <div class="chart">${histogram(p)}</div>
    </section>
    <nav class="next" aria-label="Другие специалисты"><a href="#">← На главную</a><a href="#${next.id}">Следующий специалист: ${next.name} →</a></nav>
  </div>`;
}

function contacts(){
