<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Центр «Точка опоры»</title>
</head><body style="margin:0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;1,400&family=Golos+Text:wght@400;500;600&display=swap">
<style>
/* Layout: спокойная редакционная сетка — узкая колонка текста, много воздуха, мотив из двух пересекающихся кругов (опора) */
:root{
  --bg:#FFFFFF; --surface:#F2F6F4; --fg:#22282A; --muted:#66706F; --line:#DCE4E1;
  --accent:#3E6E66; --sage:#9DBFB7; --sand:#D9A47E; --on-accent:#FFFFFF;
  --font-display:"Lora", Georgia, "Times New Roman", serif;
  --font-body:"Golos Text", "Segoe UI", Roboto, Arial, sans-serif;
  --max:1080px;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#141917; --surface:#1C2321; --fg:#E7ECEA; --muted:#9BA6A3; --line:#2C3633;
  --accent:#8EBDB3; --sage:#5E8C83; --sand:#D9A47E; --on-accent:#10201C; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#141917; --surface:#1C2321; --fg:#E7ECEA; --muted:#9BA6A3; --line:#2C3633;
  --accent:#8EBDB3; --sage:#5E8C83; --sand:#D9A47E; --on-accent:#10201C; color-scheme:dark}

*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:var(--font-body);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:var(--accent);text-underline-offset:3px}
a:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}
h1,h2,h3{font-family:var(--font-display);font-weight:500;line-height:1.2;text-wrap:balance;margin:0}
p{margin:0}
.wrap{max-width:var(--max);margin:0 auto;padding-left:max(16px, env(safe-area-inset-left, 0px));padding-right:max(16px, env(safe-area-inset-right, 0px))}
.eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:600}

/* Шапка */
.site-header{border-bottom:1px solid var(--line)}
.site-header .wrap{display:flex;flex-direction:column;gap:20px;padding-block:28px 24px}
.brand{display:flex;align-items:center;gap:14px;text-decoration:none;color:var(--fg)}
.brand svg{flex:none}
.brand-name{font-family:var(--font-display);font-size:22px;line-height:1.15}
.brand-sub{display:block;font-family:var(--font-body);font-size:13px;color:var(--muted);margin-top:2px}
.nav{display:flex;flex-wrap:wrap;gap:6px 18px;font-size:15px}
.nav a{color:var(--fg);text-decoration:none;padding-block:4px;border-bottom:1px solid transparent}
.nav a:hover,.nav a[aria-current="page"]{border-bottom-color:var(--accent);color:var(--accent)}
.nav .label{color:var(--muted);font-size:13px;align-self:center}

main{padding-block:48px 64px}
.view{display:flex;flex-direction:column;gap:56px}

/* Главная: аннотация */
.hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:40px;align-items:center}
.hero h1{font-size:clamp(32px,5vw,50px)}
.hero p{font-size:18px;color:var(--muted);max-width:56ch;margin-top:18px}
.hero-art{justify-self:end;max-width:100%}
.spheres{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px 32px}
.sphere{display:flex;flex-direction:column;gap:8px;padding-top:16px;border-top:1px solid var(--line)}
.sphere h3{font-size:19px}
.sphere p{color:var(--muted);font-size:15px}
.section-head{display:flex;flex-direction:column;gap:8px;margin-bottom:24px}
.section-head h2{font-size:28px}

/* Специалисты: карточки-ссылки */
.team{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}
.person{display:flex;flex-direction:column;gap:12px;text-decoration:none;color:var(--fg)}
.person .ph{aspect-ratio:4/5;max-width:100%;border-radius:12px;overflow:hidden;background:var(--surface)}
.person .ph svg{display:block;width:100%;height:100%}
.person strong{font-family:var(--font-display);font-weight:500;font-size:18px;line-height:1.25}
.person span{color:var(--muted);font-size:14px}
.person:hover strong{color:var(--accent)}

/* Подвал */
.site-footer{background:var(--surface)}
.site-footer .wrap{display:grid;grid-template-columns:minmax(0,1.2fr) repeat(2,minmax(0,1fr));gap:32px;padding-block:40px}
.site-footer h3{font-size:18px;margin-bottom:10px}
.site-footer p,.site-footer li{font-size:15px;color:var(--muted)}
.site-footer ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:4px}
.site-footer .copy{grid-column:1/-1;font-size:13px;color:var(--muted);border-top:1px solid var(--line);padding-top:16px}
.btn{display:inline-flex;align-items:center;gap:8px;margin-top:14px;padding:10px 16px;border-radius:999px;background:var(--accent);color:var(--on-accent);text-decoration:none;font-weight:500;font-size:15px}

/* Страница специалиста */
.crumbs{font-size:14px;color:var(--muted)}
.crumbs a{color:var(--muted)}
.profile{display:grid;grid-template-columns:minmax(0,320px) minmax(0,1fr);gap:48px;align-items:start}
.profile .ph{aspect-ratio:4/5;border-radius:16px;overflow:hidden;background:var(--surface);max-width:100%}
.profile .ph svg{display:block;width:100%;height:100%}
.profile h1{font-size:clamp(30px,4.4vw,44px)}
.role{font-size:18px;color:var(--accent);margin-top:8px}
.profile .about{display:flex;flex-direction:column;gap:16px;max-width:62ch}
.facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:8px}
.fact{padding:14px 16px;border-radius:12px;background:var(--surface)}
.fact b{display:block;font-family:var(--font-display);font-weight:500;font-size:24px;font-variant-numeric:tabular-nums}
.fact span{font-size:13px;color:var(--muted)}
.tags{display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:0;list-style:none}
.tags li{font-size:14px;padding:5px 12px;border:1px solid var(--line);border-radius:999px}
.chart-block{display:flex;flex-direction:column;gap:12px}
.chart-block h2{font-size:24px}
.chart-block p{color:var(--muted);font-size:15px}
.chart{overflow-x:auto}
.chart svg{display:block;width:100%;min-width:320px;height:auto}
.next{display:flex;flex-wrap:wrap;gap:8px 20px;font-size:15px}

/* Контакты */
.contacts{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.6fr);gap:40px;align-items:start}
.contacts dl{display:grid;grid-template-columns:auto 1fr;gap:10px 18px;margin:0}
.contacts dt{color:var(--muted);font-size:14px}
.contacts dd{margin:0}
.map{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:var(--surface)}
.map svg{display:block;width:100%;height:auto}
.route{display:flex;flex-direction:column;gap:10px;padding-left:20px;margin:0}
.legend{display:flex;flex-wrap:wrap;gap:8px 20px;font-size:13px;color:var(--muted);padding:12px 16px;border-top:1px solid var(--line)}
.legend i{display:inline-block;width:14px;height:4px;border-radius:2px;margin-right:6px;vertical-align:middle}

@media (max-width:860px){
  .hero,.profile,.contacts{grid-template-columns:minmax(0,1fr)}
  .hero-art{justify-self:start;width:220px}
  .spheres{grid-template-columns:repeat(2,minmax(0,1fr))}
  .team{grid-template-columns:repeat(2,minmax(0,1fr))}
  .site-footer .wrap{grid-template-columns:minmax(0,1fr)}
  .profile .ph{max-width:300px}
}
@media (max-width:520px){
  .spheres{grid-template-columns:minmax(0,1fr)}
  .facts{grid-template-columns:minmax(0,1fr)}
}
@media (prefers-reduced-motion:no-preference){
  .view{animation:fade .35s ease both}
  @keyframes fade{from{opacity:.4;transform:translateY(4px)}to{opacity:1;transform:none}}
}
</style>

