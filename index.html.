    method:"Игровая и арт-терапия", years:7, format:"Очно",
    clients:[22,39,61,88,117],
    look:{skin:"#F0CDB4", hair:"#B07A48", style:"bun", shirt:"#D9A47E", bg:"#F4EBE3"} },
  { id:"volkov", name:"Дмитрий Волков", role:"Кризисный психолог",
    short:"Кризисы и утраты",
    about:[
      "Работает с людьми в острых жизненных ситуациях: утрата близкого, травмирующие события, внезапные перемены.",
      "Помогает справиться с профессиональным выгоранием и восстановить ресурс после длительного стресса."
    ],
    topics:["Переживание утраты","Психологическая травма","Профессиональное выгорание","Острый стресс"],
    method:"Травмафокусированная терапия", years:15, format:"Очно и онлайн",
    clients:[41,55,77,98,126],
    look:{skin:"#D4A584", hair:"#6B6B6B", style:"beard", shirt:"#2F4F49", bg:"#E1EAE7"} },
];
const YEARS = [2021,2022,2023,2024,2025];
const SPHERES = [
  ["Семейное консультирование","Отношения в паре, конфликты, развод, воспитание детей."],
  ["Детская и подростковая психология","Адаптация, страхи, учёба, взросление."],
  ["Тревога и депрессия","Панические атаки, бессонница, сниженное настроение."],
  ["Кризисные состояния","Утрата, травмирующие события, острый стресс."],
  ["Профессиональное выгорание","Усталость, потеря смысла, восстановление ресурса."],
  ["Психодиагностика","Тестирование и оценка эмоционального состояния."],
];

/* Иллюстрированный портрет (вместо фотографии) */
function portrait(p){
  const l=p.look;
  const hair = {
    long:`<path d="M58 92c0-34 18-52 42-52s42 18 42 52v70H58z" fill="${l.hair}"/>`,
    short:`<path d="M66 86c0-24 14-38 34-38s34 14 34 38c-6-8-18-14-34-14s-28 6-34 14z" fill="${l.hair}"/>`,
    bun:`<circle cx="100" cy="40" r="16" fill="${l.hair}"/><path d="M64 90c0-28 15-44 36-44s36 16 36 44c-8-12-20-18-36-18s-28 6-36 18z" fill="${l.hair}"/>`,
    beard:`<path d="M66 86c0-24 14-38 34-38s34 14 34 38c-6-8-18-14-34-14s-28 6-34 14z" fill="${l.hair}"/><path d="M72 104c4 26 16 38 28 38s24-12 28-38c-6 10-16 14-28 14s-22-4-28-14z" fill="${l.hair}"/>`
  }[l.style];
  return `<svg viewBox="0 0 200 250" role="img" aria-label="Портрет: ${p.name}">
    <rect width="200" height="250" fill="${l.bg}"/>
    <circle cx="160" cy="44" r="26" fill="#FFFFFF" fill-opacity=".45"/>
    ${l.style==="long"?hair:""}
    <path d="M30 250c4-52 34-78 70-78s66 26 70 78z" fill="${l.shirt}"/>
    <rect x="88" y="140" width="24" height="30" rx="10" fill="${l.skin}"/>
    <ellipse cx="100" cy="98" rx="34" ry="42" fill="${l.skin}"/>
    ${l.style!=="long"?hair:""}
    <circle cx="87" cy="98" r="3" fill="#2B2B2B"/><circle cx="113" cy="98" r="3" fill="#2B2B2B"/>
    <path d="M90 120q10 7 20 0" stroke="#7A4B3A" stroke-width="3" fill="none" stroke-linecap="round"/>
  </svg>`;
}

/* Гистограмма динамики роста клиентов */
function histogram(p){
  const W=640,H=300,m={t:28,r:16,b:44,l:48};
  const iw=W-m.l-m.r, ih=H-m.t-m.b, max=160, step=40;
  const bw=iw/YEARS.length;
  let g="";
  for(let v=0; v<=max; v+=step){
    const y=m.t+ih-(v/max)*ih;
    g+=`<line x1="${m.l}" x2="${W-m.r}" y1="${y}" y2="${y}" stroke="var(--line)" stroke-width="1"/>`+
       `<text x="${m.l-10}" y="${y+4}" text-anchor="end" font-size="12" fill="var(--muted)">${v}</text>`;
  }
  p.clients.forEach((v,i)=>{
    const h=(v/max)*ih, x=m.l+i*bw+bw*0.2, y=m.t+ih-h, w=bw*0.6;
    const last=i===p.clients.length-1;
    g+=`<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="4" fill="${last?"var(--accent)":"var(--sage)"}"/>`+
       `<text x="${x+w/2}" y="${y-8}" text-anchor="middle" font-size="13" font-weight="600" fill="var(--fg)">${v}</text>`+
       `<text x="${x+w/2}" y="${H-m.b+22}" text-anchor="middle" font-size="13" fill="var(--muted)">${YEARS[i]}</text>`;
  });
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Гистограмма: число клиентов по годам, ${p.name}">${g}</svg>`;
}

function navLinks(current){
  const nav=document.getElementById("nav");
  nav.querySelectorAll("a").forEach(a=>a.remove());
  SPECIALISTS.forEach(p=>{
    const a=document.createElement("a"); a.href="#"+p.id; a.textContent=p.name;
    if(current===p.id) a.setAttribute("aria-current","page");
    nav.appendChild(a);
  });
  const c=document.createElement("a"); c.href="#contacts"; c.textContent="Контакты";
  if(current==="contacts") c.setAttribute("aria-current","page");
  nav.appendChild(c);
}

